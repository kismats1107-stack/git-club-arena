# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These are public identifiers, not secrets; access is enforced by Firebase Auth + firestore.rules.
# Copy to .env.local for development, and add the same four variables in Vercel → Settings → Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
