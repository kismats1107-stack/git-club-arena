rules_version = '2';

// Git Club Arena — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Private progress: only the signed-in owner can read or write their own document.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'savedAt'])
        && request.resource.data.state is string && request.resource.data.state.size() < 900000;
    }

    // Public leaderboard row: anyone can read; only the owner can write their row,
    // and only these fields with sane values.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'year', 'branch', 'xp', 'solved', 'streak', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.year is int && request.resource.data.year >= 1 && request.resource.data.year <= 4
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 20000
        && request.resource.data.solved is int && request.resource.data.streak is int;
    }
  }
}
